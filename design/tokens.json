{
  "$description": "claireyouk.com design tokens (DTCG). The ONE source: scripts/tokens.mjs writes app/tokens.generated.css. Palette: 'Santa Barbara dusk over marble' — a midnight-to-coral dusk for the live surfaces (hero, video, contact) and cool marble white with midnight ink for reading. Deliberately not the Utopia black + gold.",
  "color": {
    "$type": "color",
    "dusk": {
      "midnight": {
        "$value": "#0b1430",
        "$description": "dark ground, hero/video/contact"
      },
      "indigo": {
        "$value": "#1f2b66",
        "$description": "mesh gradient stop"
      },
      "violet": {
        "$value": "#6b5fc7",
        "$description": "mesh gradient stop"
      },
      "coral": {
        "$value": "#ef8f84",
        "$description": "mesh gradient stop, sunset"
      },
      "peach": {
        "$value": "#f6cdb9",
        "$description": "mesh gradient highlight"
      }
    },
    "marble": {
      "$value": "#f4f3f0",
      "$description": "reading ground"
    },
    "marble-2": {
      "$value": "#e9e7e2",
      "$description": "alternate band, input ground"
    },
    "ink": {
      "$value": "#0e1733",
      "$description": "headings on marble"
    },
    "text": {
      "$value": "#2b3254",
      "$description": "body on marble (10.9:1)"
    },
    "muted": {
      "$value": "#575e7d",
      "$description": "meta, dates (5.9:1 on marble)"
    },
    "accent": {
      "$value": "#3f3aa6",
      "$description": "links, primary button on marble (7.6:1)"
    },
    "accent-hover": {
      "$value": "#2e2a86"
    },
    "rose": {
      "$value": "#b2475b",
      "$description": "small marks: numerals, rules (5.0:1 on marble)"
    },
    "line": {
      "$value": "#d7d4cd",
      "$description": "hairlines on marble"
    },
    "on-dusk": {
      "$value": "#f7f3ee",
      "$description": "text on dusk"
    },
    "on-dusk-muted": {
      "$value": "#c9c6dd",
      "$description": "secondary text on dusk"
    },
    "glass": {
      "$value": "#ffffff1a",
      "$description": "glass fill on dusk"
    },
    "glass-line": {
      "$value": "#ffffff3d",
      "$description": "glass border on dusk"
    },
    "focus": {
      "$value": "#ffb3a8",
      "$description": "focus ring on dusk"
    },
    "paper": {
      "$value": "#ffffff",
      "$description": "the resume sheet"
    }
  },
  "font": {
    "$type": "fontFamily",
    "display": {
      "$value": [
        "Newsreader",
        "Georgia",
        "serif"
      ],
      "$description": "names, headings, numerals (variable opsz, italic)"
    },
    "sans": {
      "$value": [
        "Inter",
        "system-ui",
        "sans-serif"
      ],
      "$description": "body, UI"
    }
  },
  "size": {
    "$type": "dimension",
    "hero-name": {
      "$value": "clamp(3.5rem, 7.4vw, 7rem)"
    },
    "h2": {
      "$value": "clamp(2.25rem, 4.6vw, 4rem)"
    },
    "h3": {
      "$value": "1.375rem"
    },
    "body": {
      "$value": "1.0625rem"
    },
    "small": {
      "$value": "0.875rem"
    },
    "eyebrow": {
      "$value": "0.8125rem"
    },
    "stat": {
      "$value": "clamp(2.75rem, 5.5vw, 4.75rem)"
    }
  },
  "space": {
    "$type": "dimension",
    "1": {
      "$value": "4px"
    },
    "2": {
      "$value": "8px"
    },
    "3": {
      "$value": "12px"
    },
    "4": {
      "$value": "16px"
    },
    "5": {
      "$value": "24px"
    },
    "6": {
      "$value": "32px"
    },
    "7": {
      "$value": "48px"
    },
    "8": {
      "$value": "64px"
    },
    "9": {
      "$value": "96px"
    },
    "10": {
      "$value": "144px"
    },
    "gutter": {
      "$value": "clamp(20px, 5vw, 64px)"
    },
    "max": {
      "$value": "1200px"
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": "8px"
    },
    "md": {
      "$value": "14px"
    },
    "pill": {
      "$value": "999px"
    },
    "arch": {
      "$value": "999px 999px 18px 18px",
      "$description": "the arched window around her photo"
    }
  },
  "shadow": {
    "$type": "shadow",
    "lift": {
      "$value": {
        "color": "#0b14302e",
        "offsetX": "0px",
        "offsetY": "24px",
        "blur": "60px",
        "spread": "-12px"
      }
    }
  },
  "duration": {
    "$type": "duration",
    "fast": {
      "$value": "180ms"
    },
    "base": {
      "$value": "600ms"
    },
    "intro": {
      "$value": "1400ms"
    }
  }
}